# Every variable the app reads (validated at boot by src/lib/env.ts). Names only.

# Neon (or any Postgres) connection string
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Auth.js — generate with: npx auth secret (required in production)
AUTH_SECRET=""

# Google OAuth (console.cloud.google.com -> Credentials -> OAuth client, Web)
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (resend.com) — powers magic-link email sign-in and the intake notification
AUTH_RESEND_KEY=""

# "true" only when running `next start` off Vercel (the e2e webServer sets it)
AUTH_TRUST_HOST=""

# Public discovery intake (/api/intake). Unset INTAKE_KEY = every submission is refused.
INTAKE_KEY=""
INTAKE_OWNER_EMAIL=""

# Vercel Cron bearer for /api/kickoff/worker. Unset = the worker refuses every call.
CRON_SECRET=""

# Build Kickoff planner
ANTHROPIC_API_KEY=""
KICKOFF_ENABLED=""
KICKOFF_KILL_SWITCH=""
KICKOFF_MODEL=""
KICKOFF_TOKEN_CAP=""
KICKOFF_TIMEOUT_MS=""
KICKOFF_MAX_CONCURRENT=""
KICKOFF_DAILY_CEILING=""

# Set by Vercel on deployments; leave unset locally
VERCEL_ENV=""

# "1" lets integration/e2e tests reach a cloud (Neon) database deliberately; CI sets it
ALLOW_CLOUD_DB=""

# Test harness only (read by tests / e2e, never by the app)
BK_LIVE=""
BK_RUNS=""
BK_CONC=""
BK_ARTIFACT_DIR=""
E2E_BASE_URL=""
