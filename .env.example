# Neon (or any Postgres) connection string
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth (console.cloud.google.com -> Credentials -> OAuth client, Web)
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
